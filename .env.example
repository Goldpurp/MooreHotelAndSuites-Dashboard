# Browser-exposed values only. Never put credentials in a VITE_ variable.
VITE_APP_ENV=local
VITE_API_MODE=proxy
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000
VITE_DEV_PORT=3000
VITE_PREVIEW_PORT=4173

# Used only by the Vite development proxy; it is not bundled into the browser.
API_PROXY_TARGET=http://127.0.0.1:5222
